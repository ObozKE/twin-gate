# ==============================================================================
# ha-rhel-cluster/app/Containerfile
# Production Container Image for HA Transaction API (Podman/RHEL 9 Compatible)
# ==============================================================================

FROM registry.access.redhat.com/ubi9/nodejs-20:latest

WORKDIR /opt/app-root/src

# Copy package manifests first for efficient layer caching
COPY --chown=1001:0 package.json ./

# Install production dependencies only
RUN npm install --omit=dev --no-audit --no-fund

# Copy application source code
COPY --chown=1001:0 server.js ./

# Set environment
ENV NODE_ENV=production
ENV PORT=3000

# Expose microservice listening port
EXPOSE 3000

# Container healthcheck for Podman
HEALTHCHECK --interval=5s --timeout=2s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3000/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

# Run as non-privileged user (1001)
USER 1001

CMD ["node", "server.js"]
